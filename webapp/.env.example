# 필수: Agent SDK 인증 키 (https://platform.claude.com 에서 발급)
ANTHROPIC_API_KEY=sk-ant-...

# 선택: 대상 서비스 로그인 자격증명 — config/target.json 의 ${ENV:...} 와 매칭
# (페르소나 에이전트가 로그인 단계에서 환경변수로 주입받음. 로그·리포트에 노출 금지)
QA_TEST_EMAIL=
QA_TEST_PASSWORD=

# [필수] 슈퍼관리자 로그인 비밀번호 — 고유한 강한 값으로 반드시 설정(미설정/공개기본값이면 서버 미기동)
QA_PASSWORD=
# [필수] 세션 쿠키 서명 시크릿 — 랜덤 32자 이상 권장(미설정/공개기본값이면 서버 미기동)
#   생성: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#   이 값은 안전하게 회전 가능(회전 시 기존 로그인 세션만 만료).
QA_SESSION_SECRET=
# [필수] 비밀번호 해시 전용 PEPPER — 세션 시크릿과 분리(서버 전용, 쿠키 미전송).
#   한번 정하면 바꾸지 말 것: 변경 시 모든 회원이 비밀번호를 재설정해야 한다.
#   클라우드 뷰어가 회원 로그인을 검증하려면 동일 값을 cloud 시크릿 PW_HASH_SECRET 에도 넣는다.
QA_PW_PEPPER=
# [선택] 슈퍼관리자 로그인 아이디 (기본 admin)
QA_ADMIN_ID=admin

# 서버 포트 (기본 5510)
PORT=5510

# 페르소나 동시 실행 수 (기본 3 — 브라우저 부하/비용 고려해 작게 시작)
QA_CONCURRENCY=3

# 각 페르소나 에이전트가 쓸 모델 (sonnet | opus | haiku)
QA_MODEL=sonnet

# Playwright MCP 사용 여부 (기본 true). false면 인지적 워크스루(시뮬레이션) 모드.
QA_ENABLE_PLAYWRIGHT=true

# [선택] 내부망(localhost·127.x·10.x·172.16~31.x·192.168.x) 대상의 "로그인 후 화면 탐색"을 허용할지.
#   비어 있거나 true 가 아니면 → 내부망 대상은 탐색을 건너뜀(SSRF 가드). 로컬 개발 대상을 탐색하려면 true.
QA_ALLOW_INTERNAL_EXPLORE=

# ── [선택] 클라우드 결과공유 뷰어 동기화 ──
#   아래 두 값이 모두 있어야 동기화가 켜진다. 비어 있으면 동기화는 no-op(로컬 전용 동작, 앱에 영향 없음).
# 클라우드 Worker 주소 (예: https://qa-viewer.<계정>.workers.dev)
CLOUD_SYNC_URL=
# 로컬↔클라우드 공유 토큰 — 클라우드에 넣은 wrangler secret SYNC_TOKEN 과 같은 값
SYNC_TOKEN=
# 자동 동기화 주기(ms). 비어 있거나 0 이면 주기 폴링 없음(수동/이벤트 시에만). 예: 300000 = 5분
SYNC_INTERVAL_MS=
