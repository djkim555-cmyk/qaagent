# 실제 자격증명·세션을 포함하므로 커밋 금지
config/target.json
config/.auth/
reports/runs/
# 시크릿 파일 — 예시(.env.example)만 커밋한다
.env
.env.*
!.env.example
.dev.vars
.dev.vars.*
# MCP 접속 설정에 토큰을 직접 넣지 않는다(환경변수 참조). 로컬 개인 설정은 커밋 금지
.claude/settings.local.json

# 의존성 / 빌드 산출물
node_modules/

# 로그·임시 산출물
*.log
.playwright-mcp/
# 화면에서 삭제한 시나리오의 보관함(소프트 삭제) — 저장소에 되살리지 않는다
scenarios/_trash/

# 배포/전달용 산출물(zip 등) — 저장소에 바이너리 커밋 금지
output/

