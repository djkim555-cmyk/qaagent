{
  "name": "qa-viewer-cloud",
  "private": true,
  "type": "module",
  "description": "QA 결과 클라우드 뷰어 — Hono on Cloudflare Workers + D1 + R2 (06_API계약서 구현)",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "migrate:local": "wrangler d1 migrations apply qa-viewer-db --local",
    "migrate:remote": "wrangler d1 migrations apply qa-viewer-db --remote",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.0.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.80.0"
  }
}
